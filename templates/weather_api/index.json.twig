{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d')|raw }}",
            "celsius": "{{ m.celsius }}",
            "fahrenheit": "{{ m.fahrenheit }}"
        }{{ not loop.last ? ',' : '' }}
        {% endfor %}
    ]
}
